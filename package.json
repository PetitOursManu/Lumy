{
  "name": "lumy-docs",
  "version": "0.1.0",
  "description": "A light, multilingual, interactive documentation site generator. Markdown in, fast static pages out.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lumy": "bin/lumy.js"
  },
  "files": [
    "bin",
    "src",
    "theme",
    "templates",
    "README.md",
    "README.fr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node bin/lumy.js dev --root site",
    "build": "node bin/lumy.js build --root site",
    "check": "node bin/lumy.js check --root site",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "documentation",
    "static-site-generator",
    "markdown",
    "i18n",
    "mcp"
  ],
  "dependencies": {
    "marked": "^18.0.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetitOursManu/Lumy.git"
  },
  "homepage": "https://github.com/PetitOursManu/Lumy#readme",
  "bugs": {
    "url": "https://github.com/PetitOursManu/Lumy/issues"
  }
}
